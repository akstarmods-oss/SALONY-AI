<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme inheriting Material3 Dark NoActionBar -->
    <style name="Theme.SalonyAI" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your light/dark theme here. -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSecondary">@color/cyan_accent</item>
        <item name="colorOnSecondary">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Custom styled buttons and cards -->
    <style name="Widget.Salony.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_dark</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>
</resources>
