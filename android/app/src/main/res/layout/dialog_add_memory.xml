<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save New Memory"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Salony will remember this across conversations."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Memory Key/Topic -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Topic / Key"
        android:textColor="@color/cyan_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="14dp"
        android:hint="e.g. Favorite food, Birthday"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:maxLines="1" />

    <!-- Memory Content -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Memory Detail"
        android:textColor="@color/cyan_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogContent"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card_rounded"
        android:gravity="top|start"
        android:padding="12dp"
        android:hint="e.g. User loves Biryani and dark chocolate"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp" />

    <!-- Category -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Category"
        android:textColor="@color/cyan_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogCategory"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="14dp"
        android:hint="Personal, Preference, Fact, or Task"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:textSize="14sp"
        android:maxLines="1" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_muted" />

        <Button
            android:id="@+id/btnDialogSave"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:backgroundTint="@color/purple_primary"
            android:text="@string/btn_save"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
