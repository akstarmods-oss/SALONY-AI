<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <!-- Top Toolbar / Header -->
    <LinearLayout
        android:id="@+id/topToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/state_standby"
                android:textColor="@color/cyan_accent"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Flashlight Button -->
        <ImageButton
            android:id="@+id/btnTorch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:src="@drawable/ic_torch"
            android:contentDescription="Flashlight"
            android:padding="9dp"
            app:tint="@color/text_secondary"
            android:layout_marginEnd="8dp" />

        <!-- Memories Screen Button -->
        <ImageButton
            android:id="@+id/btnMemories"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:src="@drawable/ic_memory"
            android:contentDescription="@string/title_memories"
            android:padding="9dp"
            app:tint="@color/purple_primary"
            android:layout_marginEnd="8dp" />

        <!-- Settings Screen Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_pill"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/title_settings"
            android:padding="9dp"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- State Badge Pill -->
    <TextView
        android:id="@+id/tvStateBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:text="@string/state_standby"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/topToolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Central AI Animated Orb Custom View -->
    <com.akstarcompany.salony.ai.ui.AiOrbView
        android:id="@+id/aiOrbView"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:contentDescription="Salony AI Voice Orb"
        app:layout_constraintTop_toBottomOf="@id/tvStateBadge"
        app:layout_constraintBottom_toTopOf="@id/cardTranscript"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Transcript / Subtitle Live Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTranscript"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        app:cardBackgroundColor="@color/card_dark"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/scrollQuickActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvTranscriptSpeaker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Salony"
                android:textColor="@color/purple_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTranscriptText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Namaste! Mai Salony hoon. Mujhse kuch bhi pucho ya bolo!"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Quick Action Chips (Hinglish/Hindi Prompts) -->
    <HorizontalScrollView
        android:id="@+id/scrollQuickActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomControls">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chip1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="@string/prompt_1"
                android:textColor="@color/cyan_light"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="@string/prompt_2"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="@string/prompt_3"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="@string/prompt_4"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:text="@string/prompt_5"
                android:textColor="@color/pink_light"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Bottom Voice Controls -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Mute Toggle Button -->
            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_pill"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/btn_mute"
                android:padding="14dp"
                app:tint="@color/text_secondary"
                android:layout_marginEnd="20dp" />

            <!-- Primary Voice Assistant Toggle FAB -->
            <ImageButton
                android:id="@+id/btnVoiceToggle"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_mic_idle"
                android:src="@drawable/ic_mic"
                android:contentDescription="@string/btn_start_session"
                android:padding="20dp"
                app:tint="@android:color/white"
                android:elevation="8dp" />

            <!-- Interrupt / Stop Speaking Button -->
            <ImageButton
                android:id="@+id/btnInterrupt"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_pill"
                android:src="@drawable/ic_mic_off"
                android:contentDescription="@string/btn_interrupt"
                android:padding="14dp"
                app:tint="@color/text_secondary"
                android:layout_marginStart="20dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvVoiceHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/btn_start_session"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
